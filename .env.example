# Оставьте пустым в dev: запросы пойдут на тот же origin,
# а Vite проксирует /api и /ws на http://localhost:8000.
VITE_API_URL=

# Явный адрес WebSocket-сервера (без /ws). По умолчанию — текущий origin.
# Пример для прод-сборки, если API на другом домене:
# VITE_WS_URL=https://api.example.com
VITE_WS_URL=
