# Оставьте пустым в dev: запросы пойдут на тот же origin,
# а Vite проксирует /api и /ws на http://localhost:8000.
VITE_API_URL=

# Явный адрес WebSocket-сервера (без /ws). По умолчанию — текущий origin.
# Пример для прод-сборки, если API на другом домене:
# VITE_WS_URL=https://api.example.com
VITE_WS_URL=

# Origin сервиса звонков xam_call_service (без /api/v1).
# Пусто — same-origin: Vite и nginx проксируют /calls-api и /calls-ws на сервис звонков.
# Для прямого подключения укажите, например: VITE_CALLS_URL=http://localhost:8081
# и добавьте домен фронтенда в CORS_ORIGINS сервиса звонков.
VITE_CALLS_URL=

# --- Docker Compose ---
# Порт, на котором фронтенд будет доступен на хосте.
FRONTEND_PORT=8080

# Куда nginx проксирует /api и /ws. По умолчанию — бэкенд,
# запущенный на хосте (docker compose в xam_backend публикует порт 8000).
# В общей docker-сети укажите имя сервиса, например http://api:8000.
BACKEND_ORIGIN=http://host.docker.internal:8000

# Куда nginx проксирует /calls-api и /calls-ws. По умолчанию — сервис звонков
# xam_call_service, запущенный на хосте (порт 8081).
# В общей docker-сети укажите имя сервиса, например http://calls:8081.
CALLS_ORIGIN=http://host.docker.internal:8081

# --- Docker: HTTPS -----------------------------------------------------------
# HTTPS обслуживает тот же nginx с самоподписанным сертификатом.
FRONTEND_TLS_PORT=8444
# Имена/IP для SAN сертификата. Добавьте адрес, по которому открываете фронтенд
# с другого устройства, например TLS_HOSTS=localhost,127.0.0.1,192.168.1.50
TLS_HOSTS=localhost,127.0.0.1
TLS_CN=localhost
TLS_CERT_DAYS=825
# Установите 1, чтобы пересоздать сертификат при следующем запуске.
TLS_REGENERATE=0
