# Оставьте пустым в dev: запросы пойдут на тот же origin,
# а Vite проксирует /api и /ws на http://localhost:8000.
VITE_API_URL=

# Явный адрес WebSocket-сервера (без /ws). По умолчанию — текущий origin.
# Пример для прод-сборки, если API на другом домене:
# VITE_WS_URL=https://api.example.com
VITE_WS_URL=

# --- Docker Compose ---
# Порт, на котором фронтенд будет доступен на хосте.
FRONTEND_PORT=8080

# Куда nginx проксирует /api и /ws. По умолчанию — бэкенд,
# запущенный на хосте (docker compose в xam_backend публикует порт 8000).
# В общей docker-сети укажите имя сервиса, например http://api:8000.
BACKEND_ORIGIN=http://host.docker.internal:8000
